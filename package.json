{
    "name": "newscast-audit-ui",
    "version": "1.0.0",
    "description": "Frontend for Newscast Audit",
    "scripts": {
        "build": "node scripts/build.js",
        "test": "playwright test",
        "pretest": "node tests/fixtures/generate_fixture.js",
        "test:ui": "playwright test --ui",
        "type-check": "tsc -p docs/js/tsconfig.json --noEmit",
        "clean": "find docs/js -name '*.js' -delete && find docs/js -name '*.js.map' -delete",
        "watch": "node scripts/build.js --watch"
    },
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@types/node": "^25.0.9",
        "cross-env": "^10.1.0",
        "esbuild": "^0.19.0",
        "http-server": "^14.1.1",
        "typescript": "^5.0.0",
        "xlsx": "^0.18.5"
    },
    "type": "module"
}
